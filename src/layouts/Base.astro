---
import Navbar from '../components/Navbar.astro';
import '../index.css';
import {Font} from 'astro:assets'
const {
  title = 'nicholas karneyenka',
  description = 'Projects, writing, and experiments by Nicholas Karneyenka.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Font cssVariable='--font-inter' preload/>
  </head>
  <body>
    <Navbar />
    <slot />
  </body>
</html>
